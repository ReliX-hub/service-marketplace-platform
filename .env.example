# Copy this file to .env only when you want to override the loopback-only local defaults.
SPRING_PROFILES_ACTIVE=dev
# Required outside dev. Generate at least 32 random bytes, Base64-encode them, and uncomment.
# JWT_SECRET=replace_with_a_generated_base64_value

# The project uses the deterministic mock gateway unless this is set to stripe.
PAYMENT_GATEWAY=mock
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional absolute host URL used when image responses must be expanded beyond relative /api/files paths.
# STORAGE_LOCAL_ROOT=.marketplace-files
# STORAGE_PUBLIC_BASE_URL=https://api.example.com
# IMAGES_REQUIRE_DELIVERABLE_ON_DELIVER=true
